generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum KycLevel {
  TIER_1
  TIER_2
  TIER_3
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  FAILED
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum JournalStatus {
  POSTED
  REVERSED
}

enum SavingsGoalStatus {
  ACTIVE
  LOCKED
  COMPLETED
  CANCELLED
}

model User {
  id                   String              @id @default(cuid())
  email                String              @unique
  emailLookupHash      String?             @unique
  passwordHash         String
  isDemo               Boolean @default(false)
  credentialVersion    Int @default(0)
  recoveryFailures     Int @default(0)
  recoveryLockedUntil  DateTime? @db.Timestamptz(3)
  firstName            String
  lastName             String
  phoneNumber          String?             @unique
  phoneEncrypted       String?
  phoneLookupHash      String?             @unique
  kycLevel             KycLevel            @default(TIER_1)
  kycStatus            KycStatus           @default(NOT_STARTED)
  bvnEncrypted         String?
  bvnLastFour          String?
  ninEncrypted         String?
  ninLastFour          String?
  maxTolerableLoss     Decimal?            @db.Decimal(7, 4)
  targetReturn         Decimal?            @db.Decimal(7, 4)
  timeHorizonMonths    Int?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  wallet               Wallet?
  ledgerAccounts       LedgerAccount[]
  savingsGoals         SavingsGoal[]
  portfolioEvaluations PortfolioEvaluation[]
  kycVerifications     KycVerification[]
  globalPaperAccounts GlobalPaperAccount[]
  globalPaperPositions GlobalPaperPosition[]
  globalPaperOrders GlobalPaperOrder[]
  passwordRecoveries PasswordRecovery[]
  demoIdentity DemoIdentity?
}

// Paper-only book: never reconciled into NGN customer cash or represented as custody.
model GlobalPaperAccount {
  id String @id @default(cuid())
  userId String
  asset String @db.VarChar(8)
  code String
  normalBalance LedgerSide
  balance Decimal @default(0) @db.Decimal(30, 8)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  lines GlobalPaperLine[]
  @@unique([userId, asset, code])
}

model GlobalPaperJournal {
  id String @id @default(cuid())
  reference String @unique
  requestHash String
  asset String @db.VarChar(8)
  description String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lines GlobalPaperLine[]
}

model GlobalPaperLine {
  id String @id @default(cuid())
  journalId String
  accountId String
  side LedgerSide
  amount Decimal @db.Decimal(30, 8)
  journal GlobalPaperJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account GlobalPaperAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId])
  @@index([journalId])
}

model GlobalPaperPosition {
  id String @id @default(cuid())
  userId String
  symbol String
  asset String @db.VarChar(8)
  qty Decimal @default(0) @db.Decimal(30, 8)
  cost Decimal @default(0) @db.Decimal(30, 8)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, symbol, asset])
}

model GlobalPaperOrder {
  id String @id @default(cuid())
  userId String
  requestKey String @unique
  requestHash String
  symbol String
  side String
  asset String @db.VarChar(8)
  qty Decimal @db.Decimal(30, 8)
  price Decimal @db.Decimal(30, 8)
  amount Decimal @db.Decimal(30, 8)
  risk Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
}

model Wallet {
  id                String        @id @default(cuid())
  userId            String        @unique
  currency          String        @default("NGN") @db.Char(3)
  status            WalletStatus  @default(ACTIVE)
  virtualAccountBank String?
  virtualAccountName String?
  virtualAccountNumber String?    @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerAccount     LedgerAccount?
}

model LedgerAccount {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  accountType     AccountType
  normalBalance   LedgerSide
  currency        String          @default("NGN") @db.Char(3)
  balance         Decimal         @default(0) @db.Decimal(20, 2)
  isSystemAccount Boolean         @default(false)
  userId          String?
  walletId        String?         @unique
  savingsGoalId   String?         @unique
  parentId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User?           @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet          Wallet?         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  savingsGoal     SavingsGoal?    @relation(fields: [savingsGoalId], references: [id], onDelete: Restrict)
  parent          LedgerAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        LedgerAccount[] @relation("AccountHierarchy")
  transactions    Transaction[]

  @@index([userId, accountType])
  @@index([parentId])
}

model JournalEntry {
  id                String          @id @default(cuid())
  idempotencyKey    String?         @unique
  externalReference String?
  requestHash       String?
  description       String
  currency          String          @default("NGN") @db.Char(3)
  status            JournalStatus   @default(POSTED)
  postedAt          DateTime        @default(now())
  createdAt         DateTime        @default(now())
  transactions      Transaction[]

  @@index([externalReference])
  @@index([postedAt])
}

model IdempotencyRecord {
  key         String   @id
  requestHash String
  statusCode  Int
  response    Json
  expiresAt   DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model WebhookInbox {
  id          String   @id
  transactionKey String @unique
  requestHash String
  payloadEncrypted String
  processedAt DateTime? @db.Timestamptz(3)
  receivedAt  DateTime @default(now()) @db.Timestamptz(3)
  journalId   String?
}

model OutboxJob {
  id          String   @id @default(cuid())
  kind        String
  payload     Json
  uniqueKey   String   @unique
  attempts    Int      @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  deadAt      DateTime? @db.Timestamptz(3)
  lastError   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([completedAt, deadAt, availableAt])
}

model AuthChallenge {
  id          String   @id @default(cuid())
  userId      String
  credentialVersion Int @default(0)
  deviceHash  String
  codeHash    String
  attempts    Int      @default(0)
  expiresAt   DateTime @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordRecovery {
  id String @id
  userId String
  deviceHash String
  codeHash String
  grantHash String? @unique
  expiresAt DateTime @db.Timestamptz(3)
  verifiedAt DateTime? @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model DemoInstrument {
  symbol String @id
  name String
  category String
  asset String
  price Decimal @db.Decimal(30, 8)
  tickSize Decimal @db.Decimal(30, 8)
  qtyStep Decimal @db.Decimal(30, 8)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model DemoIdentity {
  key String @id
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AuthSession {
  id          String   @id @default(cuid())
  userId      String
  deviceHash  String
  expiresAt   DateTime @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String
  action      String
  subjectId   String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([subjectId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model SystemControl {
  id       String @id
  readOnly Boolean @default(false)
}

model PartnerExecution {
  id          String   @id
  provider    String
  simulated   Boolean
  amount      Decimal  @db.Decimal(20, 2)
  nav         Decimal  @db.Decimal(20, 6)
  units       Decimal  @db.Decimal(28, 8)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

model Transaction {
  id              String        @id @default(cuid())
  journalEntryId  String
  ledgerAccountId String
  side            LedgerSide
  amount          Decimal       @db.Decimal(20, 2)
  currency        String        @default("NGN") @db.Char(3)
  description     String?
  createdAt       DateTime      @default(now())
  journalEntry    JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([ledgerAccountId, createdAt])
  @@index([journalEntryId])
}

model SavingsGoal {
  id                 String            @id @default(cuid())
  userId             String
  name               String
  targetAmount       Decimal           @db.Decimal(20, 2)
  lockedAmount       Decimal           @default(0) @db.Decimal(20, 2)
  yieldAccrued       Decimal           @default(0) @db.Decimal(20, 2)
  autoSweep          Boolean           @default(false)
  status             SavingsGoalStatus @default(ACTIVE)
  lockUntil          DateTime?         @db.Timestamptz(3)
  endDate            DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerAccount      LedgerAccount?

  @@index([userId, status])
  @@index([status, lockUntil])
  @@index([endDate])
}

model PortfolioEvaluation {
  id                  String               @id @default(cuid())
  userId              String
  principal           Decimal              @db.Decimal(20, 2)
  maxLossPercent      Decimal              @db.Decimal(7, 4)
  riskFreeRate        Decimal              @db.Decimal(7, 6)
  timeHorizonYears    Decimal              @db.Decimal(8, 4)
  requiredTbills      Decimal              @db.Decimal(20, 2)
  floorValue          Decimal              @db.Decimal(20, 2)
  shouldRebalance     Boolean
  createdAt           DateTime             @default(now())
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  allocations         PortfolioAllocation[]

  @@index([userId, createdAt])
}

model PortfolioAllocation {
  id                     String              @id @default(cuid())
  evaluationId           String
  assetClass             String
  targetPercentage       Decimal             @db.Decimal(9, 6)
  actualPercentage       Decimal             @db.Decimal(9, 6)
  driftPercentagePoints  Decimal             @db.Decimal(9, 6)
  floorValue             Decimal?            @db.Decimal(20, 2)
  createdAt              DateTime            @default(now())
  evaluation             PortfolioEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, assetClass])
}

model KycVerification {
  id                String    @id @default(cuid())
  userId            String
  providerReference String?   @unique
  status            KycStatus @default(PENDING)
  failureReason     String?
  requestedAt       DateTime  @default(now())
  completedAt       DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, requestedAt])
}
