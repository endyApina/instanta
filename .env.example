# Local development only. Replace the password and keep DATABASE_URL in sync.
POSTGRES_USER=instanta
POSTGRES_PASSWORD=secureDatabase
POSTGRES_DB=instanta
POSTGRES_PORT=5432
DATABASE_URL="postgresql://instanta:secureDatabase@127.0.0.1:5432/instanta?schema=public"
PORT=3000
JWT_SECRET="replace-with-at-least-32-random-bytes"
PII_ENCRYPTION_KEY="replace-with-64-hex-characters"
BAAS_WEBHOOK_SECRET="2ffffafaf94e08eb69bdf2cbf9e47c78835975c373c8d2e31914745c7eed3ccd"
KYC_WEBHOOK_SECRET="2ffffafaf94e08eb69bdf2cbf9e47c78835975c373c8d2e31914745c7eed3ccd"
ATP_RISK_FREE_RATE=0.04
NODE_ENV=development
DB_POOL_MAX=10
SYSTEM_READ_ONLY_MODE=false
# Demo must use a SEPARATE database ending in _demo, with no real-mode users.
# Example: POSTGRES_DB=instanta_demo and a matching DATABASE_URL in a separate env file.
IS_DEMO_MODE=false
# Normalized, partner-certified gateway endpoints. Missing values use dev/staging mocks only.
KYC_GATEWAY_URL=""
KYC_API_KEY=""
BAAS_GATEWAY_URL=""
BAAS_API_KEY=""
FUND_GATEWAY_URL=""
FUND_API_KEY=""
SMS_GATEWAY_URL=""
SMS_API_KEY=""
# Read-only licensed market feeds. No mock prices when unconfigured.
NGX_API_TOKEN=""
# FMDQ e-Markets has no verified public API contract in this project.
# Supply your licensed normalization gateway (see PRODUCTION_README.md).
FMDQ_MARKET_GATEWAY_URL=""
FMDQ_MARKET_API_KEY=""
# Optional global sandbox integration. Missing development/staging credentials enable LABELED simulated feeds.
# Production requires a separate credentialed venue. Real-money execution remains disabled in all environments.
PERPETUALS_ENVIRONMENT=sandbox
PERPETUALS_API_KEY=""
PERPETUALS_API_SECRET=""
# BayesShield contract is not publicly verified; use a contracted normalization gateway.
BAYESSHIELD_GATEWAY_URL=""
BAYESSHIELD_API_KEY=""
